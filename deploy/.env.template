# Copie para .env dentro de deploy/ e preencha (aqui, valores recomendados de produção)

# === CORE ===
# Chave de API (se vazio, API fica aberta — deixe preenchida em produção!)
SHANDON_API_KEY=

# JWT Secret (OBRIGATÓRIO) — troque por algo longo e aleatório
JWT_SECRET=

# Chave do admin panel
NEXT_PUBLIC_ADMIN_KEY=

# CORS/Origin permitida
ALLOWED_ORIGIN=https://elite.senhoramorim.com.br
NEXT_PUBLIC_BASE_URL=https://elite.senhoramorim.com.br

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Ambiente
NODE_ENV=production
PORT=3000

# Device Lock (ativação)
SHANDON_ACTIVATION_KEY=

# === OSINT API KEYS (Opcional — melhoram resultados) ===
