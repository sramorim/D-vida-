# SHANDON ELITE — Environment Variables
# Copie este arquivo para .env.local (desenvolvimento) ou configure no Cloudflare Dashboard (produção)

# === CORE ===
# Chave de API. ATENÇÃO: vazio deixa as 27 rotas protegidas abertas para
# qualquer pessoa. Defina um valor em produção.
SHANDON_API_KEY=

# JWT Secret para autenticação (OBRIGATÓRIO em produção!)
JWT_SECRET=

# Senha do painel administrativo (/admin). Esta é a que vale: fica só no
# servidor e é comparada em /api/admin/verify.
SHANDON_ADMIN_KEY=

# E-mails do dono da conta. Separados por vírgula. Usados por requireAdmin
# para liberar as rotas de administração.
SHANDON_ADMIN_EMAILS=

# NÃO use NEXT_PUBLIC_ADMIN_KEY para o painel admin: o prefixo NEXT_PUBLIC_
# embute o valor no bundle do navegador, e qualquer pessoa lê no JavaScript.
# A variável foi removida do código de propósito — use SHANDON_ADMIN_KEY.

# Base do Worker da CENTRAL AMORIM, usada no SERVIDOR para o Instagram
# (lib/instagram/central-source.ts). Tem padrão, então costuma não precisar
# ser definida.
# CENTRAL_API_BASE=https://senhoramorim.com.br

# Base alternativa para o NAVEGADOR. Só defina se existir um Worker sempre
# ligado com as mesmas rotas da API, e só se todas responderem. Vazio (padrão)
# faz o app usar a própria origem, que é o caso correto.
# Antes esta variável apontava para a Central e quebrava 10 das 12 ferramentas
# da tela de Investigação Anônima, porque as rotas não existem lá.
# NEXT_PUBLIC_SHANDON_API_BASE=

# Origin permitida para CORS (produção — configurar após domínio)
# ALLOWED_ORIGIN=https://elite.senhoramorim.com.br

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Porta do servidor
PORT=3000

# Node Environment
NODE_ENV=development

# === BASE URL (para webhooks e redirecionamentos) ===
# NEXT_PUBLIC_BASE_URL=https://elite.senhoramorim.com.br

# === DEVICE LOCK (Chave de ativação) ===
SHANDON_ACTIVATION_KEY=

# === PROXY (Opcional) ===
# ALL_PROXY=
# HTTP_PROXY=
# HTTPS_PROXY=
# SHANDON_PROXY_URL=

# === OSINT API KEYS (Opcional — melhoram resultados) ===
# HIBP_API_KEY=
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# FB_ACCESS_TOKEN=
# PASTEBIN_API_KEY=

# === WHATSAPP LOOKUP (RapidAPI — WhatsApp OSINT) ===
# Obter chave em: https://rapidapi.com/inutil-inutil-default/api/whatsapp-osint
# RAPIDAPI_WHATSAPP_KEY=
# RAPIDAPI_WHATSAPP_HOST=whatsapp-osint.p.rapidapi.com

# === MERCADO PAGO (Pagamentos — FUTURO) ===
# Obter em: https://www.mercadopago.com.br/developers/pt/docs
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=
# MERCADO_PAGO_WEBHOOK_SECRET=

# === CLOUDFLARE (produção) ===
# As variáveis acima devem ser configuradas no Cloudflare Dashboard
# Workers & Pages > shandon-elite > Settings > Environment variables
